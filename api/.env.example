# PostgreSQL — set PG_URI for a single connection string, or the discrete vars as fallback.
PG_URI=postgresql://postgres:postgres@localhost:5433/postszn
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DBNAME=postszn

# Supabase Authentication
SUPABASE_URL=https://your-project-id.supabase.co

# RapidAPI NFL Data Client
RAPIDAPI_BASEURL=https://tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com
RAPIDAPI_APIKEY=your_rapidapi_key_here
RAPIDAPI_APIHOST=tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com

# NFL Season Configuration
SEASON_YEAR=2025

# Logging: ENVIRONMENT=development gives colorized logs; anything else gives JSON.
ENVIRONMENT=development
LOG_LEVEL=INFO
# LOG_FORMAT=auto|json|console
LOG_FORMAT=auto

# Background scheduler (disabled by default)
SCHEDULER_ENABLED=false
SCHEDULER_ROSTER_SYNC_HOURS=24
SCHEDULER_LIVE_POLL_SECONDS=90

# Comma-separated Supabase user ids (JWT `sub`) allowed to call /api/admin/*; leave empty to disable.
ADMIN_SUPABASE_UIDS=

# Deployment: comma-separated allowed CORS origins and DB pool sizing
CORS_ORIGINS=http://localhost:5173
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
