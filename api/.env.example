# Backend environment contract (read by api/core/config.py).
#
# Where each value lives in production (see docs/deploy/):
#   [fly secret]  fly secrets set NAME=... --app <app>   (secret or environment-specific)
#   [fly.toml]    non-secret, committed in fly.toml [env]
#   [local only]  development convenience, not set in production
# "Required" means the API (or the Alembic release command) refuses to start without it.

# --- Database ---------------------------------------------------------------
# Production: [fly secret] REQUIRED. One connection string; it takes priority over the
# discrete PG_* values below, which are a local-development fallback.
#   Supabase direct connection (preferred, IPv6):  postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#   Fallback, session pooler (port 5432, IPv4):    postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   NEVER the transaction pooler (port 6543): asyncpg uses prepared statements.
# URL-encode special characters in the password. Use the postgresql:// scheme (the app adds +asyncpg).
PG_URI=postgresql://postgres:postgres@localhost:5433/postszn
# [local only] used only when PG_URI is empty.
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DBNAME=postszn

# --- Supabase Auth ----------------------------------------------------------
# Production: [fly secret] REQUIRED. Project URL; the API verifies JWTs against its JWKS endpoint.
SUPABASE_URL=https://your-project-id.supabase.co

# --- RapidAPI (Tank01 NFL) --------------------------------------------------
# Production: RAPIDAPI_APIKEY [fly secret] REQUIRED for ingestion/scheduler; the other two are
# [fly.toml] or secrets (not sensitive). Only /api/admin/* and the scheduler spend quota.
RAPIDAPI_BASEURL=https://tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com
RAPIDAPI_APIKEY=your_rapidapi_key_here
RAPIDAPI_APIHOST=tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com
# [local only] cache API responses in this directory so re-seeding doesn't spend quota.
# RAPIDAPI_CACHE_DIR=.rapidapi-cache
# Hard cap on calls per UTC day (0 disables); 700 keeps a 30% margin under 1,000
RAPIDAPI_DAILY_REQUEST_LIMIT=700

# --- App --------------------------------------------------------------------
# Production: [fly.toml]. Season whose data the app serves.
SEASON_YEAR=2026

# --- Logging ----------------------------------------------------------------
# Production: [fly.toml] ENVIRONMENT=production (anything but "development" gives JSON logs).
ENVIRONMENT=development
LOG_LEVEL=INFO
# auto | json | console
LOG_FORMAT=auto

# --- Background scheduler (disabled by default; every tick can spend RapidAPI quota) ----
# Production: [fly secret]. Changing a secret restarts the machine and drops draft WebSockets, so never
# during a live draft. Leave SCHEDULER_ENABLED=false until games are near (cutover runbook, step 6).
SCHEDULER_ENABLED=false until games are near.
SCHEDULER_ENABLED=false
SCHEDULER_ROSTER_SYNC_HOURS=24
SCHEDULER_LIVE_POLL_SECONDS=180
# Rehearsal: replay a saved postseason (make export-replay) with no API calls. Never in production.
SCHEDULER_REPLAY_FILE=
SCHEDULER_REPLAY_SPEED=60

# --- Admin ------------------------------------------------------------------
# Production: [fly secret] REQUIRED to use /api/admin/*. Comma-separated Supabase user ids
# (JWT `sub`); empty means nobody is admin.
ADMIN_SUPABASE_UIDS=

# --- Deployment -------------------------------------------------------------
# Production: [fly secret] REQUIRED: comma-separated browser origins allowed to call the API,
# e.g. https://postsznfantasy.com (no trailing slash, no wildcard: credentials are allowed).
CORS_ORIGINS=http://localhost:5173
# [fly.toml] Pool per process. Supabase Free allows ~60 direct connections; keep the total below that.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Container runtime (not read by Settings) -------------------------------
# [fly.toml] Read by the Dockerfile / uvicorn, not by api/core/config.py:
#   PORT=8080                 port uvicorn listens on (must match fly.toml internal_port)
#   FORWARDED_ALLOW_IPS=*     trust Fly's proxy headers (X-Forwarded-For/Proto) behind --proxy-headers

# --- GitHub Actions secrets (not API environment variables) -----------------
# Set under repo Settings > Secrets and variables > Actions; used by the workflows in .github/workflows/:
#   FLY_API_TOKEN            deploy-api.yml        (fly tokens create deploy)
#   BACKUP_DATABASE_URL      backup.yml            read-only-capable connection string for pg_dump
#   BACKUP_GPG_PUBLIC_KEY    backup.yml            ASCII-armored PUBLIC key; the private key stays offline
