# Frontend environment contract. Vite reads VITE_* at BUILD time and bakes them into the
# bundle, so they are public: never put a secret here.
#
# Production: set these as Cloudflare Pages build variables (Settings > Variables and Secrets,
# production environment), then redeploy. See docs/deploy/frontend-hosting.md.
# "Required" means the production site does not work without it: the Pages build (CF_PAGES set,
# or REQUIRE_PRODUCTION_ENV=1) fails when an API, WebSocket or Supabase variable is missing, or
# when the API URL is not https:// or the WebSocket URL not wss://. Local builds are not checked.

# --- API and WebSocket origins ---------------------------------------------
# Production: REQUIRED. With them unset the app calls its own origin, which is Pages, not the API.
#   VITE_API_URL=https://api.postsznfantasy.com
#   VITE_WS_URL=wss://api.postsznfantasy.com
# Local dev: leave unset; the Vite dev server proxies /api (and the draft WebSocket) to
# http://localhost:8000. Set only when the API is served from another origin.
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000

# --- Supabase client --------------------------------------------------------
# Production: REQUIRED, from the Supabase production project (Project Settings > API).
# Use the Publishable Key (sb_publishable_...); the legacy anon key is a fallback.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# VITE_SUPABASE_ANON_KEY=your_legacy_supabase_anon_key_here

# --- Error tracking (Sentry, docs/deploy/sentry.md) -------------------------
# Production: the postszn-frontend project DSN as a Pages build variable. Unset disables Sentry
# (the SDK is not even bundled). Environment tag defaults to the Vite mode.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production

# --- Optional ---------------------------------------------------------------
# Shows the admin-only "Refresh now" button to these Supabase user ids (comma-separated).
# Hint only: the API still enforces ADMIN_SUPABASE_UIDS.
# VITE_ADMIN_SUPABASE_UIDS=

# GIPHY API key for the Feed's GIF button (a public key by design; create a Beta key at
# developers.giphy.com). Unset hides the button. The API only accepts GIF links from the hosts
# in its GIF_ALLOWED_HOSTS (giphy.com by default).
# VITE_GIPHY_API_KEY=

# Shows a "Support PostSzn" row in the More tab that opens this page in a new tab (the owner's
# Buy Me a Coffee page). Unset hides the row. docs/owner/24-support-link.md.
# VITE_SUPPORT_URL=

# Off-season switch. "true" makes the SPA show the "back for the next postseason" page instead of
# the app. Only the owner flips it (shutdown and wake-up runbooks); an API failure never does.
# Set as a Pages build variable and rebuild; the build publishes it as /status.json.
# VITE_DORMANT=false
