# API and WebSocket Endpoints
# Optional in local dev: the Vite dev server proxies /api (and the draft WebSocket) to
# http://localhost:8000. Set these only when the API is served from another origin.
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000

# Supabase Client Credentials
# Note: Use modern Publishable Key (sb_publishable_...), or legacy Anon Key (VITE_SUPABASE_ANON_KEY)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# VITE_SUPABASE_ANON_KEY=your_legacy_supabase_anon_key_here
